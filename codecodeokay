-- Detect which HTTP request method actually reaches Kimi in this executor
local _workingRequestFn = nil
local _workingRequestName = nil
local function normalizeResponse(res)
    if type(res) ~= "table" then return res end
    if not res.StatusCode and res.status then res.StatusCode = res.status end
    if not res.StatusCode and res.statusCode then res.StatusCode = res.statusCode end
    if not res.Body and res.body then res.Body = res.body end
    if not res.Headers and res.headers then res.Headers = res.headers end
    return res
end
local function findWorkingRequest()
    if _workingRequestFn then return _workingRequestFn end
    local testUrl = "https://api.moonshot.ai/v1/models"
    local testHeaders = {
        ["Authorization"] = "Bearer " .. _aiKey,
        ["User-Agent"] = "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36",
        ["Accept"] = "application/json",
    }
    local candidates = {
        {name="request", fn=request},
        {name="http_request", fn=http_request},
        {name="syn.request", fn=syn and syn.request},
        {name="krnl.request", fn=krnl and krnl.request},
        {name="fluxus.request", fn=fluxus and fluxus.request},
        {name="Olympus.request", fn=Olympus and Olympus.request},
        {name="HttpService:RequestAsync", fn=function(opts)
            return HttpService:RequestAsync({
                Url = opts.Url,
                Method = opts.Method,
                Headers = opts.Headers,
                Body = opts.Body
            })
        end}
    }
    for _, cand in ipairs(candidates) do
        if type(cand.fn) == "function" then
            local ok, res = pcall(function()
                return cand.fn({
                    Url = testUrl,
                    Method = "GET",
                    Headers = testHeaders
                })
            end)
            if ok and res then
                res = normalizeResponse(res)
                if res.StatusCode == 200 then
                    warn("[MysteriousReedem] Working request method found: " .. cand.name)
                    _workingRequestFn = cand.fn
                    _workingRequestName = cand.name
                    return _workingRequestFn
                else
                    warn("[MysteriousReedem] Request test '" .. cand.name .. "' status: " .. tostring(res.StatusCode) .. " body: " .. tostring(res.Body):sub(1,100))
                end
            else
                warn("[MysteriousReedem] Request test '" .. cand.name .. "' error: " .. tostring(res))
            end
        end
    end
    warn("[MysteriousReedem] WARNING: No working request method found for api.moonshot.ai. Real Executor may block Kimi.")
    return nil
end
task.defer(findWorkingRequest)

