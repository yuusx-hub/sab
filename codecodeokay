    lbl.TextSize=10
    lbl.Font=Enum.Font.GothamBold
    lbl.TextColor3=T.White
    lbl.TextXAlignment=Enum.TextXAlignment.Left
    lbl.TextYAlignment=Enum.TextYAlignment.Center
    lbl.ZIndex=103
    lbl.Parent=row

    local btn=Instance.new("TextButton")
    btn.Size=UDim2.new(0,36,0,18)
    btn.AnchorPoint=Vector2.new(1,0.5)
    btn.Position=UDim2.new(1,-7,0.5,0)
    btn.BackgroundColor3=state and T.Green or T.Red
    btn.BorderSizePixel=0
    btn.AutoButtonColor=false
    btn.Text=state and "ON" or "OFF"
    btn.TextSize=9
    btn.Font=Enum.Font.GothamBold
    btn.TextColor3=state and T.BG or T.White
    btn.ZIndex=103
    btn.Parent=row
    Corner(btn,5)

    btn.MouseButton1Click:Connect(function()
        state=not state
        if state then
            btn.Text="ON"; btn.BackgroundColor3=T.Green; btn.TextColor3=T.BG
        else
            btn.Text="OFF"; btn.BackgroundColor3=T.Red; btn.TextColor3=T.White
        end
        callback(state)
    end)
    return row
end

makeToggle("Auto-Write", 3, _autoWrite, function(v)
    _autoWrite=v
    if not _autoWrite then
        if _batchTimer then pcall(task.cancel, _batchTimer); _batchTimer=nil end
        for _, key in ipairs(_currentBatchParts) do _codeQueueSeen[key] = nil end
        _writeCount=0; _batchSubmitting=false; table.clear(_currentBatchParts)
    end
    setStatus(_autoWrite and "Auto-Write ON" or "Auto-Write OFF", _autoWrite and T.Green or T.Dim)
end)

