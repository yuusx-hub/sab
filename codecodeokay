local function normalizeCode(text)
    if not text then return "" end
    return tostring(text):upper():gsub("%s+", ""):gsub("[^A-Z0-9]", "")
end

local S_MAX = 10000
local MS_MAX = 1000
local SAGO_MAX = 10000
local SEC_MAX = 10000
local NUM_MAX = 1000000000000

local function isStandaloneNumber(w)
    -- Allow short numbers (1-3 digits) as codes; block 4+ digit counters
    if w:match("^%d+$") then
        local n = tonumber(w)
        return n and #w >= 4 and n <= NUM_MAX
    end
    return false
end

local function isSecSpam(w)
    local num = w:match("^(%d+)SEC$")
    if num then
        local n = tonumber(num)
        return n and n >= 1 and n <= SEC_MAX
    end
    return false
end

local function isSSpam(w)
    local num = w:match("^(%d+)S$")
    if num then
        local n = tonumber(num)
        return n and n >= 0 and n <= S_MAX
    end
    return false
end

local function isMsSpam(w)
    local num = w:match("^(%d+)MS$")
    if num then
        local n = tonumber(num)
        return n and n >= 0 and n <= MS_MAX
    end
    return false
end

local function isSagoSpam(w)
    local num = w:match("^(%d+)SAGO$")
    if num then
        local n = tonumber(num)
        return n and n >= 0 and n <= SAGO_MAX
    end
    return false
end

local function isAgoSpam(w)
    local num = w:match("^(%d+)AGO$")
    if num then
        local n = tonumber(num)
        return n and n >= 0 and n <= 1000000
    end
    return false
end

local function isUnitSpam(w)
    return w:match("^%d+[KMBT]$") ~= nil
end

local function isInSpam(w)
    local d, h = w:match("^IN(%d+)D(%d+)H$")
    if d and h then
        local dn, hn = tonumber(d), tonumber(h)
        return dn and hn and dn <= 1000 and hn <= 100
    end
    return false
end

local function isMsagoSpam(w)
    local m, s = w:match("^(%d+)M(%d+)SAGO$")
    if m and s then
        local mn, sn = tonumber(m), tonumber(s)
        return mn and sn and mn <= 100 and sn <= 100
    end
    return false
end

local function isMinSecSpam(w)
    local m, s = w:match("^(%d+)M(%d+)S$")
    if m and s then
        local mn, sn = tonumber(m), tonumber(s)
        return mn and sn and mn <= 1000 and sn <= 1000
    end
    return false
end

local function isMagoSpam(w)
    local m = w:match("^(%d+)MAGO$")
    if m then
        local n = tonumber(m)
        return n and n >= 0 and n <= 1000
    end
    return false
end

local function isStartingInSpam(w)
    local n, unit = w:match("^STARTINGIN(%d+)([DHMS])$")
    if n and unit then
        local num = tonumber(n)
        return num and num >= 0 and num <= 10000
    end
    return false
end

local function isTimeUnitSpam(w)
    local n = w:match("^(%d+)[DHMS]$")
    if n then
        local num = tonumber(n)
        return num and num >= 0 and num <= 10000
    end
    return false
end

local function isFPSSpam(w)
    local num = w:match("^(%d+)FPS$")
    if num then
        local n = tonumber(num)
        return n and n >= 0 and n <= 10000000
    end
    return false
end

local function isAMPMSpam(w)
    local num = w:match("^(%d+)[AP]M$")
    if num then
        local n = tonumber(num)
        return n and n >= 0 and n <= 10000
    end
    return false
end

SPAM_PHRASES = {
    "please wait before trying to redeem",
    "invalid code", "code invalid", "please wait", "already redeemed",
    "wait before", "you must wait", "too fast", "slow down",
    "try again", "cannot redeem", "redeem another",
    "starting in", "starts in",
}
local function isSpamText(txt)
    local l = txt:lower()
    for _, p in ipairs(SPAM_PHRASES) do
        if l:find(p, 1, true) then return true end
    end
    if l:find("unclaimed") or l:find("dinobro") or l:find("0los") or l:find("og3") or l:find("admin") then return true end
    return false
end

