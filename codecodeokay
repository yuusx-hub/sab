RejoinBtn.MouseButton1Click:Connect(function()
    setStatus("Rejoining...", T.Yellow)
    local TeleportService = game:GetService("TeleportService")
    local isPrivate = game.PrivateServerId ~= "" and game.PrivateServerId ~= nil

    -- Get source and save it so it can be re-executed after teleport
    local source
    if getscriptsource then
        pcall(function() source = getscriptsource(script) end)
    end
    if not source and readfile then
        pcall(function() source = readfile("mysterious_reedem_code.txt") end)
    end
    if source and writefile then
        pcall(function() writefile("mysterious_reedem_code.txt", source) end)
    end

    -- Queue script to run after teleport
    if queue_on_teleport then
        if source then
            pcall(queue_on_teleport, source)
        else
            pcall(queue_on_teleport, [[pcall(function() loadstring(readfile("mysterious_reedem_code.txt") or "")() end)]])
        end
    end

    task.wait(0.5)
    local ok = false

    -- Method 1: executor built-in rejoin (best for private servers)
    if rejoin then
        ok = pcall(rejoin)
        if ok then return end
    end

    -- Method 2: teleport to same instance
    ok = pcall(function()
        TeleportService:TeleportToPlaceInstance(game.PlaceId, game.JobId, lp)
    end)
    if ok then return end

    -- Method 3: teleport async to same place (keeps private server if possible)
    ok = pcall(function()
        local opts = Instance.new("TeleportOptions")
        opts.ServerInstanceId = game.JobId
        TeleportService:TeleportAsync(game.PlaceId, {lp}, opts)
    end)
    if ok then return end

    -- Method 4: plain teleport
    ok = pcall(function()
        TeleportService:Teleport(game.PlaceId, lp)
    end)
    if ok then return end

    if isPrivate then
        setStatus("Private server rejoin failed. Use executor rejoin.", T.Red)
    else
        setStatus("Rejoin failed", T.Red)
    end
end)

