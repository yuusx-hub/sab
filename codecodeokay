            local ok, res = pcall(function() return fn(opts) end)
            if ok and res then
                res = normalizeResponse(res)
                warn("[MysteriousReedem] " .. label .. " status: " .. tostring(res.StatusCode) .. " body: " .. tostring(res.Body):sub(1,200))
                return res
            elseif not ok then
                warn("[MysteriousReedem] " .. label .. " error: " .. tostring(res))
            end
            return nil
        end

        local function executorRequest()
            for _, fn in ipairs(requestFuncs) do
                if type(fn) == "function" then
                    local res = tryFn(fn, {Url = url, Method = "POST", Headers = headers, Body = body}, "executor request")
                    if res then return res end
                    res = tryFn(fn, {url = url, method = "POST", headers = headers, body = body}, "executor request (lowercase)")
                    if res then return res end
                end
            end
            return nil
        end

        local function attempt()
            -- If we already found a working request method, use it
            if _workingRequestFn then
                local opts = {Url = url, Method = "POST", Headers = headers, Body = body}
                local res = tryFn(_workingRequestFn, opts, "working request [" .. tostring(_workingRequestName) .. "]")
                if res and res.StatusCode == 200 then return res end
