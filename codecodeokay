local function isGuiVisible(obj)
    if not obj or not obj.Visible then return false end
    local cur = obj.Parent
    while cur do
        if cur:IsA("GuiObject") and not cur.Visible then return false end
        if cur:IsA("ScreenGui") and not cur.Enabled then return false end
        cur = cur.Parent
    end
    return true
end

local function _isCodeBox(obj)
    if not obj:IsA("TextBox") then return false end
    if GUI and obj:IsDescendantOf(GUI) then return false end
    local hint = ((obj.PlaceholderText or "") .. " " .. obj.Name):lower()
    local parentNames = ""
    local cur = obj.Parent
    for i=1,3 do
        if not cur then break end
        parentNames = parentNames .. " " .. (cur.Name or "")
        cur = cur.Parent
    end
    local full = (hint .. " " .. parentNames):lower()
    return full:find("code") or full:find("redeem") or full:find("here")
        or full:find("enter") or full:find("input") or full:find("promo")
        or full:find("gift") or full:find("codes") or full:find("key")
        or full:find("serial") or full:find("coupon") or full:find("voucher")
        or full:find("token")
end

local function findCodeTextBox()
    if _cachedBox and _cachedBox.Parent and isGuiVisible(_cachedBox) then return _cachedBox end
    _cachedBox = nil
    local pg = lp:FindFirstChild("PlayerGui")
    if not pg then return nil end
    for _, obj in ipairs(pg:GetDescendants()) do
        if _isCodeBox(obj) and isGuiVisible(obj) then
            _cachedBox = obj
            return obj
        end
    end
    return nil
end

local function isSubmitButton(obj)
    if not (obj:IsA("TextButton") or obj:IsA("ImageButton")) then return false end
    if GUI and obj:IsDescendantOf(GUI) then return false end
    if not isGuiVisible(obj) then return false end
    local hint = (((obj:IsA("TextButton") and obj.Text) or "") .. " " .. obj.Name):lower()
    return hint:find("redeem") ~= nil or hint:find("submit") ~= nil
end

local function fireSubmitButton(nearObj)
    if not _aggressiveSubmit then return false end
    local target = nil
    local container = nearObj and nearObj.Parent or nil
    local levels = 0
    while container and not target and levels < 5 do
        for _, obj in ipairs(container:GetDescendants()) do
            if isSubmitButton(obj) then target = obj; break end
        end
        container = container.Parent
        levels = levels + 1
    end
    if not target then return false end
    if firesignal then
        pcall(function() firesignal(target.MouseButton1Click) end)
        pcall(function() firesignal(target.Activated) end)
    end
    return true
end

local function getRedemptionRF()
    if _rfRemote and _rfRemote.Parent then return _rfRemote end
    _rfRemote = nil
    -- Try the common Steal a Brainrot folder first
    local rfFolder = ReplicatedStorage:FindFirstChild("RF")
    if rfFolder then
        local rf = rfFolder:FindFirstChild("RequestRedemption")
        if rf and rf:IsA("RemoteFunction") then _rfRemote = rf; return _rfRemote end
        for _, v in ipairs(rfFolder:GetChildren()) do
            if v.Name == "RequestRedemption" and v:IsA("RemoteFunction") then
                _rfRemote = v
                return _rfRemote
            end
        end
    end
    -- Anti-cheat fallback: search all ReplicatedStorage descendants for redemption remotes
    local candidates = {
        "RequestRedemption", "RedeemCode", "Redeem", "SubmitCode", "CodeRedemption",
        "ClaimCode", "UseCode", "CheckCode", "RedeemCodes", "RequestCode"
    }
    local function scan(parent)
        for _, v in ipairs(parent:GetDescendants()) do
            if v:IsA("RemoteFunction") then
                local name = v.Name:upper()
                for _, c in ipairs(candidates) do
                    if name:find(c:upper(), 1, true) then
                        _rfRemote = v
                        return v
                    end
                end
            end
        end
        return nil
    end
    local found = scan(ReplicatedStorage)
