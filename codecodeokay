            local execRes = executorRequest()
            if execRes and execRes.StatusCode == 200 then return execRes end

            local reqRes = tryFn(function(opts)
                return HttpService:RequestAsync({
                    Url = opts.Url,
                    Method = opts.Method,
                    Headers = opts.Headers,
                    Body = opts.Body
                })
            end, {Url = url, Method = "POST", Headers = headers, Body = body}, "RequestAsync")

            if reqRes and reqRes.StatusCode == 200 then return reqRes end
            return execRes or reqRes
        end

        local res = attempt()
        local status = res and (res.StatusCode or res.status or res.statusCode)
        if retry and (status == 401 or status == 429) then
            task.wait(1)
            res = attempt()
        end
        return res
    end

