local function writeToBox(box, text)
    if not box or not box.Parent then return false end
    pcall(function() box.ClearTextOnFocus = false end)
    pcall(function() box:CaptureFocus() end)
    if _fastSubmit then
        -- Instant set (fastest, but more detectable by some anti-cheats)
        local ok = pcall(function()
            box.Text = text
            box.CursorPosition = #text + 1
        end)
        return ok
    end
    local ok = pcall(function() box.Text = "" end)
    if not ok then return false end
    for i = 1, #text do
        ok = pcall(function()
            box.Text = text:sub(1, i)
            box.CursorPosition = i + 1
        end)
        if not ok then return false end
        task.wait(0.005 + math.random() * 0.005) -- tiny human jitter
    end
    return true
end

local function typeAppend(box, text)
    if not box or not box.Parent then return false end
    pcall(function() box.ClearTextOnFocus = false end)
    pcall(function() box:CaptureFocus() end)
    if _fastSubmit then
        local ok = pcall(function()
            box.Text = (box.Text or "") .. text
            box.CursorPosition = #(box.Text or "") + 1
        end)
        return ok
    end
    local cur = box.Text or ""
    for i = 1, #text do
        local ok = pcall(function()
            box.Text = cur .. text:sub(1, i)
            box.CursorPosition = #cur + i + 1
        end)
        if not ok then return false end
        task.wait(0.005 + math.random() * 0.005)
    end
    return true
end

local function getClickDelay()
    local base = _fastSubmit and 0.03 or _clickSubmitDelay
    return base + math.random() * 0.05 -- small human jitter
end

local function pressEnter()
    if _noVIM then return end -- Avoid detectable VirtualInputManager; FocusLost(true) handles submit
    pcall(function()
        local vim = game:GetService("VirtualInputManager")
        vim:SendKeyEvent(true, Enum.KeyCode.Return, false, game)
        task.wait(_fastSubmit and 0.02 or 0.06)
        vim:SendKeyEvent(false, Enum.KeyCode.Return, false, game)
    end)
end

local function submitOneCode(code)
    if redeemViaRF(code) then return true end
    local box = findCodeTextBox()
    local waited = 0
    while not box and waited < 5 do
        setStatus("Waiting for code box...", T.Yellow)
        task.wait(0.1)
        waited = waited + 0.1
        box = findCodeTextBox()
    end
    if not box then setStatus("No code box", T.Red); return false end
    writeToBox(box, code)
    task.wait(_fastSubmit and 0.01 or 0.03)
    pcall(function() box:ReleaseFocus(true) end)
    task.wait(getClickDelay())
    pressEnter()
    task.wait(0.02)
    if _aggressiveSubmit then
        fireSubmitButton(box)
    end
    setStatus("Submitted: " .. code, T.Green)
    return true
end

function trySubmitQueue()
    if _submitBusy or not _autoSubmit or #_codeQueue == 0 then return end
    _submitBusy = true
    task.spawn(function()
        while #_codeQueue > 0 do
            local code = _codeQueue[1]
            if submitOneCode(code) then
                table.remove(_codeQueue, 1)
                _codeQueueSeen[normalizeCode(code)] = nil
            else
                setStatus("Retrying: " .. code, T.Yellow)
                task.wait(_fastSubmit and 0.1 or 0.5)
            end
            local waitBase = _delayEnabled and _submitDelay > 0 and _submitDelay or (_fastSubmit and 0.05 or 0.15)
            task.wait(waitBase + math.random() * 0.1)
        end
        _submitBusy = false
        if #_codeQueue >= _submitAfter then trySubmitQueue() end
    end)
end

local function finishBatch()
    if _batchSubmitting or _writeCount == 0 then return end
    _batchSubmitting = true
    if _batchTimer then
        pcall(task.cancel, _batchTimer)
        _batchTimer = nil
    end
    local box = findCodeTextBox()
    if not box then
        _batchSubmitting = false
        return
    end
    local full = (box.Text or ""):gsub("%s+", "")
    writeToBox(box, full)
    task.spawn(function()
        task.wait(_fastSubmit and 0.01 or 0.02)
        pcall(function() box:ReleaseFocus(true) end)
        task.wait(getClickDelay())
        pressEnter()
        if _aggressiveSubmit then fireSubmitButton(box) end
        setStatus("Submitted: " .. full, T.Green)
        task.wait(0.08)
        box.Text = ""
        _writeCount = 0
        for _, key in ipairs(_currentBatchParts) do _codeQueueSeen[key] = nil end
        table.clear(_currentBatchParts)
        _batchSubmitting = false
    end)
end

local function appendToFocusedBox(text)
    if not text or text=="" then return end
    if not _focused or not _focused.Parent then
        setStatus("Click the code box first!",T.Yellow)
        flashCode(text, T.Yellow)
        return
    end
    local cur=_focused.Text or ""
    _focused.Text = cur=="" and text or cur.." "..text
    setStatus("Appended!",T.Green)
    flashCode(text,T.Green)
end

local function handleCode(code, fromAI)
    if not code or code=="" then return end
    warn("[MysteriousReedem] handleCode" .. (fromAI and " [AI]" or " [basic]") .. ": " .. code:sub(1,100))
    if _batchSubmitting then return end
    local formatted = code:upper()
    local norm = normalizeCode(formatted)
    local isAppendPart = _autoSubmit
    local isShortNumber = norm:match("^%d+$") and #norm <= 3
    if norm == "" then return end
    if not fromAI and not (isAppendPart and isShortNumber) and isSpamWord(norm) then return end
    if not isAppendPart and _codeQueueSeen[norm] then setStatus("Already queued", T.Dim); return end
    if not isAppendPart then _codeQueueSeen[norm] = true end
    flashCode(formatted, T.Green)

    if _autoSubmit then
        -- Collect parts in the redeem box; submit only when target count is reached (no timeout)
        local box = findCodeTextBox()
        if not box then
            setStatus("No code box", T.Yellow)
            return
        end
        local cur = box.Text or ""
        if cur == "" or cur:match("^%s*$") then
            box.Text = formatted
        else
            box.Text = cur .. " " .. formatted
        end
        _writeCount = _writeCount + 1
        table.insert(_currentBatchParts, norm)
        setStatus("Part " .. _writeCount .. "/" .. _submitAfter .. ": " .. formatted, T.Green)
        if _writeCount >= _submitAfter then
            finishBatch()
        end
    elseif _autoWrite then
        local box = findCodeTextBox()
        if not box then
            setStatus("No code box", T.Yellow)
            return
        end
        typeAppend(box, formatted)
        setStatus("Wrote: " .. (box.Text or ""), T.Green)
    else
        appendToFocusedBox(formatted)
    end
end

local function extractCodeTokens(txt)
    local rawPieces = {}
    for piece in txt:gmatch("[A-Za-z0-9]+") do
        table.insert(rawPieces, piece:upper())
    end

    -- Combine adjacent letter+digit pieces: FREE + 67 → FREE67
    local combined = {}
    for i = 1, #rawPieces - 1 do
        local a, b = rawPieces[i], rawPieces[i+1]
        local aLetters = a:match("^[A-Z]+$")
        local bLetters = b:match("^[A-Z]+$")
        local aDigits = a:match("^%d+$")
        local bDigits = b:match("^%d+$")
        if (aLetters and bDigits) or (aDigits and bLetters) then
            local merged = a .. b
            if #merged <= 20 then
                table.insert(combined, merged)
            end
        end
    end

    local tokens = {}
    local function addIfValid(p, idx)
        if #p < 1 or #p > 20 then return end
        if isSpamWord(p) then return end
        if COMMON_WORDS[p] then return end
        -- Pure numbers only allowed if preceded by CODE IS or FREE
        if p:match("^%d+$") then
            local prev = rawPieces[idx and idx - 1]
            local prev2 = rawPieces[idx and idx - 2]
            local allowed = false
            if prev == "FREE" then
                allowed = true
            elseif prev == "IS" and prev2 == "CODE" then
                allowed = true
            end
            if not allowed then return end
        end
        table.insert(tokens, p)
    end
    for idx, p in ipairs(rawPieces) do addIfValid(p, idx) end
    for _, p in ipairs(combined) do
        if #p >= 1 and #p <= 20 and not isSpamWord(p) and not COMMON_WORDS[p] then
            table.insert(tokens, p)
        end
    end

    -- Remove tokens that are substrings of other tokens
    local filtered = {}
    for i, a in ipairs(tokens) do
        local keep = true
        for j, b in ipairs(tokens) do
            if i ~= j and #b > #a and b:find(a, 1, true) then
                keep = false
                break
            end
        end
        if keep then table.insert(filtered, a) end
    end

    return filtered
end

local function extractAfterPrefix(txt)
    local prefixes = {"CODE IS ", "CODE IS: ", "THE CODE IS ", "REDEEM CODE ", "NEW CODE ", "CODE: "}
    local upper = txt:upper()
    for _, prefix in ipairs(prefixes) do
        local start = upper:find(prefix, 1, true)
        if start then
            local rest = txt:sub(start + #prefix)
            local code = rest:match("[A-Za-z0-9]+")
            if code then return code:upper() end
        end
    end
    return nil
end

local function handleAICode(aiCode)
    warn("[MysteriousReedem] AI output: " .. aiCode)
    setStatus("AI found: " .. aiCode, T.Green)
    -- Final guard: never write/submit known bad answers
    local normCode = aiCode:upper():gsub("%s+", "")
    local BAD_ANSWERS = {["OG3"]=true, ["SSSKIBIDI"]=true, ["SSKIBIDI"]=true, ["SKIBIDISKIBIDI"]=true, ["SKIBIDITOILET"]=true}
    if BAD_ANSWERS[normCode] or #normCode < 1 then
        warn("[MysteriousReedem] Bad AI answer blocked: " .. aiCode)
        return
    end
    if _aiLastWritten[normCode] and (tick() - _aiLastWritten[normCode]) < 5 then
        warn("[MysteriousReedem] AI answer spam prevented: " .. aiCode)
        return
    end
    _aiLastWritten[normCode] = tick()
    if _aiAutoSubmit then
        -- Submit AI answer immediately (do not batch with other answers)
        local box = findCodeTextBox()
        if not box then
            setStatus("No code box for AI submit", T.Yellow)
            return
        end
        task.spawn(function()
            writeToBox(box, aiCode)
            task.wait(_fastSubmit and 0.01 or 0.05)
            pcall(function() box:ReleaseFocus(true) end)
            task.wait(getClickDelay())
            pressEnter()
            if _aggressiveSubmit then fireSubmitButton(box) end
            setStatus("AI submitted: " .. aiCode, T.Green)
            task.wait(0.08)
            box.Text = ""
        end)
    elseif _aiWrite then
        local box = findCodeTextBox()
        if box then
            typeAppend(box, aiCode)
        else
            setStatus("No code box for AI write", T.Yellow)
        end
    else
        handleCode(aiCode, true)
    end
end

local function looksLikeQuestion(txt)
    if not txt then return false end
    if txt:find("?") then return true end
    local lower = txt:lower()
    local qWords = {"what", "when", "where", "who", "why", "how", "which", "whose", "whom", "is it", "can you", "do you", "are you", "guess", "riddle", "question", "answer"}
    for _, w in ipairs(qWords) do
        if lower:find(w, 1, true) then return true end
    end
    return false
end

local function processGlobal(txt)
    if not _enabled then return end
    if not txt or type(txt)~="string" or #txt<1 then return end
    if isSpamText(txt) then return end
    local norm = normalizeCode(txt)
    local isAppendMode = _autoSubmit
    local isShortNumberOnly = norm:match("^%d+$") and #norm <= 3
    if norm == "" then return end
    if not (isAppendMode and isShortNumberOnly) and isSpamWord(norm) then return end
    if not isAppendMode and _rawSeen[norm] then return end
    _rawSeen[norm]=true
    task.delay(1, function() _rawSeen[norm]=nil end)

    local isQuestion = looksLikeQuestion(txt)

    -- If AI is enabled and text looks like a question/riddle, let AI handle it (skip basic detection)
    if _aiEnabled and isQuestion then
        if tick() - _aiLastCall < _aiCallCooldown then return end
        _aiLastCall = tick()
        local normQ = txt:lower():gsub("%s+", ""):gsub("%p", "")
        if _aiLastQuestion[normQ] and (tick() - _aiLastQuestion[normQ]) < 15 then
            warn("[MysteriousReedem] AI question spam prevented: " .. txt:sub(1,50))
            return
        end
        _aiLastQuestion[normQ] = tick()
        if _aiBusy then
            warn("[MysteriousReedem] AI busy, skipping question")
            return
        end
        _aiBusy = true
        -- Clear any stale batch parts so old answers never mix with this new one
        table.clear(_aiBatchParts)
        _aiBatchCount = 0
        task.spawn(function()
            local aiCode = askAIForCode(txt)
            _aiBusy = false
            if aiCode then
                handleAICode(aiCode)
            end
        end)
        return
    end

    local tokens = extractCodeTokens(txt)
    if #tokens > 0 then
        for _, c in ipairs(tokens) do handleCode(c) end
    else
        local prefixed = extractAfterPrefix(txt)
        if prefixed then handleCode(prefixed) end
    end

    -- Also try AI on non-questions if no code was found
    if _aiEnabled and tick() - _aiLastCall >= _aiCallCooldown then
        _aiLastCall = tick()
        local normQ = txt:lower():gsub("%s+", ""):gsub("%p", "")
        if _aiLastQuestion[normQ] and (tick() - _aiLastQuestion[normQ]) < 15 then
            warn("[MysteriousReedem] AI text spam prevented: " .. txt:sub(1,50))
            return
        end
        _aiLastQuestion[normQ] = tick()
        if _aiBusy then
            warn("[MysteriousReedem] AI busy, skipping text")
            return
        end
        _aiBusy = true
        table.clear(_aiBatchParts)
        _aiBatchCount = 0
        task.spawn(function()
            local aiCode = askAIForCode(txt)
            _aiBusy = false
            if aiCode then
                handleAICode(aiCode)
            end
        end)
    end
end

local _watched={}
local function watchLabel(obj)
    if _watched[obj] then return end
    _watched[obj]=true
    obj:GetPropertyChangedSignal("Text"):Connect(function()
        processGlobal(obj.Text)
    end)
end

local BAD={"backpack","inventory","chatmain","bubblechat","overhead","nametag","leaderboard","hudgui"}
local GOOD={"global","announce","notif","banner","broadcast","event","popup","sammy","alert","header","news","system","message","center"}
local function classify(obj)
    local n=(obj.Name or ""):lower()
    local pn=((obj.Parent and obj.Parent.Name) or ""):lower()
    local gpn=((obj.Parent and obj.Parent.Parent and obj.Parent.Parent.Name) or ""):lower()
    for _,b in ipairs(BAD) do if n:find(b) or pn:find(b) then return false end end
    for _,g in ipairs(GOOD) do
        if n:find(g) or pn:find(g) or gpn:find(g) then return true end
    end
    return false
end

local function isVisibleLabel(obj)
    if not obj then return false end
    if obj:IsA("TextLabel") or obj:IsA("TextButton") then
        if obj.TextTransparency == 1 then return false end
    end
    return true
end

playerGui.DescendantAdded:Connect(function(obj)
    task.wait(0.04)
    if not obj or not obj.Parent then return end
    if obj:IsA("TextLabel") and isVisibleLabel(obj) then
        local txt=obj.Text or ""
        if (classify(obj) or #extractCodeTokens(txt) > 0) and not isSpamText(txt) then
            watchLabel(obj)
            if #txt>=1 then processGlobal(txt) end
        end
        obj:GetPropertyChangedSignal("Text"):Connect(function()
            if not isVisibleLabel(obj) then return end
            local t=obj.Text or ""
            if (classify(obj) or #extractCodeTokens(t) > 0) and not isSpamText(t) then
                if not _watched[obj] then watchLabel(obj) end
                processGlobal(t)
            end
        end)
    end
end)

