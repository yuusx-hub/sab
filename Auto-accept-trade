local dragging = false
local dragStart, frameStart
titleBar.InputBegan:Connect(function(inp)
    if inp.UserInputType == Enum.UserInputType.MouseButton1 then
        dragging = true
        dragStart = inp.Position
        frameStart = main.Position
        inp.Changed:Connect(function()
            if inp.UserInputState == Enum.UserInputState.End then
                dragging = false
            end
        end)
    end
end)

UserInput.InputChanged:Connect(function(inp)
    if dragging and inp.UserInputType == Enum.UserInputType.MouseMovement then
        local delta = inp.Position - dragStart
        main.Position = UDim2.new(frameStart.X.Scale, frameStart.X.Offset + delta.X, frameStart.Y.Scale, frameStart.Y.Offset + delta.Y)
    end
end)

local function makeToggle(y, labelText, varName)
    local row = Instance.new("Frame")
    row.Size = UDim2.new(1, -20, 0, 35)
    row.Position = UDim2.new(0, 10, 0, y)
    row.BackgroundTransparency = 1
    row.Parent = main

    local lbl = Instance.new("TextLabel")
    lbl.Size = UDim2.new(0.6, 0, 1, 0)
    lbl.BackgroundTransparency = 1
    lbl.Text = labelText
    lbl.TextColor3 = Color3.new(0.9, 0.9, 0.9)
    lbl.Font = Enum.Font.Gotham
    lbl.TextSize = 14
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.Parent = row

    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(0, 55, 0, 25)
    btn.Position = UDim2.new(0.65, 0, 0.5, -12.5)
    btn.BackgroundColor3 = settings[varName] and Color3.new(0.3, 0.7, 0.3) or Color3.new(0.7, 0.3, 0.3)
    btn.Text = settings[varName] and "ON" or "OFF"
    btn.TextColor3 = Color3.new(1,1,1)
    btn.Font = Enum.Font.GothamBold
    btn.TextSize = 12
    btn.BorderSizePixel = 0

    local btnCorner = Instance.new("UICorner")
    btnCorner.CornerRadius = UDim.new(1, 0)
    btnCorner.Parent = btn
    btn.Parent = row

    btn.MouseButton1Click:Connect(function()
        settings[varName] = not settings[varName]
        btn.BackgroundColor3 = settings[varName] and Color3.new(0.3, 0.7, 0.3) or Color3.new(0.7, 0.3, 0.3)
        btn.Text = settings[varName] and "ON" or "OFF"
        saveCfg()
    end)
end

makeToggle(45, "Auto Trade", "tradeOn")
makeToggle(90, "Anti-AFK Jump", "afkJump")

local function setupAutoTrade()
    local container = plr.PlayerGui:FindFirstChild("DuelsMachinePrompt")
    if container and container:FindFirstChild("DuelsMachinePrompt") then
        container = container.DuelsMachinePrompt
    else
        return false
    end

    local conn
    conn = container.ChildAdded:Connect(function(child)
        if child.Name == "Prompt" and settings.tradeOn then
            local label = child:FindFirstChild("Label", true)
            if label and label.Text == "Trade Request" then
                clickYes(child)
            end
        end
    end)
    return conn
end

local tradeLoopRunning = false
local afkLoopRunning = false

task.spawn(function()
    while task.wait(2) do
        if settings.tradeOn and not tradeLoopRunning then
            tradeLoopRunning = true
            task.spawn(function()
                while settings.tradeOn and task.wait(0.5) do
                    acceptTrade()
                end
                tradeLoopRunning = false
            end)
        elseif not settings.tradeOn and tradeLoopRunning then
            tradeLoopRunning = false
        end

        if settings.afkJump and not afkLoopRunning then
            afkLoopRunning = true
            task.spawn(function()
                while settings.afkJump and task.wait(5) do
                    jump()
                end
                afkLoopRunning = false
            end)
        elseif not settings.afkJump and afkLoopRunning then
            afkLoopRunning = false
        end
    end
end)

local currentConnection = nil
local function watchForContainer()
    if currentConnection then
        currentConnection:Disconnect()
        currentConnection = nil
    end

    local container = plr.PlayerGui:FindFirstChild("DuelsMachinePrompt")
    if container and container:FindFirstChild("DuelsMachinePrompt") then
        currentConnection = setupAutoTrade()
    else
        local guiConn
        guiConn = plr.PlayerGui.ChildAdded:Connect(function(child)
            if child.Name == "DuelsMachinePrompt" then
                task.wait(0.5)
                currentConnection = setupAutoTrade()
                guiConn:Disconnect()
            end
        end)
    end
end

watchForContainer()

plr.PlayerGui.ChildAdded:Connect(function()
    watchForContainer()
end)

