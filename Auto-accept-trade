local Players = game:GetService("Players")
local plr = Players.LocalPlayer
local Vim = cloneref(game:GetService("VirtualInputManager"))
local UserInput = game:GetService("UserInputService")
local cfgFile = "tradecfg.json"
local settings = {
    tradeOn = true,
    afkJump = true
}

local function loadCfg()
    local ok, data = pcall(readfile, cfgFile)
    if ok and data ~= "" then
        local decoded = game:GetService("HttpService"):JSONDecode(data)
        settings.tradeOn = decoded.tradeOn
        settings.afkJump = decoded.afkJump
    end
end

local function saveCfg()
    local encoded = game:GetService("HttpService"):JSONEncode(settings)
    pcall(writefile, cfgFile, encoded)
end

loadCfg()

local function clickYes(prompt)
    local yes = prompt:FindFirstChild("Yes", true)
    if yes then
        if firesignal then
            firesignal(yes.Activated)
        else
            local pos = yes.AbsolutePosition + yes.AbsoluteSize / 2
            Vim:SendMouseButtonEvent(pos.X, pos.Y, 0, true, game, 1)
            Vim:SendMouseButtonEvent(pos.X, pos.Y, 0, false, game, 1)
        end
    end
end

local function acceptTrade()
    local btn = plr.PlayerGui.TradeLiveTrade.TradeLiveTrade.Other.ReadyButton
    if btn then
        if firesignal then
            firesignal(btn.Activated)
        else
            local pos = btn.AbsolutePosition + btn.AbsoluteSize / 2
            Vim:SendMouseButtonEvent(pos.X, pos.Y, 0, true, game, 1)
            Vim:SendMouseButtonEvent(pos.X, pos.Y, 0, false, game, 1)
        end
    end
end

local function jump()
    local char = plr.Character
    if char and char:FindFirstChild("Humanoid") then
        local hum = char.Humanoid
        if hum and hum.Health > 0 then
            hum:ChangeState(Enum.HumanoidStateType.Jumping)
        end
    end
end

