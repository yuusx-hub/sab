--////////////////////////////////////////////////////
--// RAINBOW
--////////////////////////////////////////////////////

local rainbowLoop = false

local function rainbowEffect()
	if rainbowLoop then return end
	rainbowLoop = true

	task.spawn(function()
		while rainbowLoop do
			for i = 0,1,0.02 do
				if not rainbowLoop then break end
				brainrotLabel.TextColor3 = Color3.fromHSV(i,1,1)
				task.wait(0.03)
			end
		end
	end)
end

--////////////////////////////////////////////////////
--// DRAGGING (FIXED)
--////////////////////////////////////////////////////

local dragging = false
local dragStart
local startPos

topBar.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 and not gotLegendary then
		dragging = true
		dragStart = input.Position
		startPos = frame.Position

		input.Changed:Connect(function()
			if input.UserInputState == Enum.UserInputState.End then
				dragging = false
			end
		end)
	end
end)

UIS.InputChanged:Connect(function(input)
	if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
		local delta = input.Position - dragStart
		frame.Position = UDim2.new(
			startPos.X.Scale,
			startPos.X.Offset + delta.X,
			startPos.Y.Scale,
			startPos.Y.Offset + delta.Y
		)
	end
end)

