local function updateScale()
	local v = workspace.CurrentCamera.ViewportSize

	if v.X < 700 then
		uiScale.Scale = 0.75
	elseif v.X < 1000 then
		uiScale.Scale = 0.9
	else
		uiScale.Scale = 1
	end
end

