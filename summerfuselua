--////////////////////////////////////////////////////
--// LEGENDARY STATE
--////////////////////////////////////////////////////

local gotLegendary = false

--////////////////////////////////////////////////////
--// REROLL
--////////////////////////////////////////////////////

local function reroll()
	if gotLegendary then return end

	local chance = math.random(1,100)
	local selected

	if chance == 1 then
		selected = brainrots[#brainrots]
	else
		selected = brainrots[math.random(1,#brainrots-1)]
	end

	brainrotLabel.TextTransparency = 1
	brainrotLabel.Text = selected.name

	TweenService:Create(brainrotLabel,TweenInfo.new(0.2),{
		TextTransparency = 0
	}):Play()

	if selected.rainbow then
		gotLegendary = true
		rainbowEffect()

		rerollBtn.Text = "🏆 OWNED"
		rerollBtn.BackgroundColor3 = Color3.fromRGB(80,80,80)
		rerollBtn.AutoButtonColor = false
		rerollBtn.Active = false

		notification.Visible = true
		TweenService:Create(notification,TweenInfo.new(0.4,Enum.EasingStyle.Back),{
			Size=UDim2.new(0,420,0,50),
			Position=UDim2.new(0.5,0,0,20)
		}):Play()

	else
		rainbowLoop = false
		brainrotLabel.TextColor3 = selected.color
	end
end

--////////////////////////////////////////////////////
--// BUTTON
--////////////////////////////////////////////////////

rerollBtn.MouseButton1Click:Connect(function()
	if gotLegendary then return end

	TweenService:Create(rerollBtn,TweenInfo.new(0.08),{Size=UDim2.new(0,205,0,50)}):Play()
	task.wait(0.08)
	TweenService:Create(rerollBtn,TweenInfo.new(0.08),{Size=UDim2.new(0,220,0,55)}):Play()

	reroll()
end)

--////////////////////////////////////////////////////
--// START
--////////////////////////////////////////////////////

reroll()
