	minimized = not minimized

	if minimized then
		content.Visible = false
		TweenService:Create(frame,TweenInfo.new(0.25),{Size=UDim2.new(0,520,0,42)}):Play()
		minBtn.Text = "+"
	else
		content.Visible = true
		TweenService:Create(frame,TweenInfo.new(0.25),{Size=originalSize}):Play()
